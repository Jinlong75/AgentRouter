@echo off
rem Read-only view of the latest AgentRouter task progress: ar-watch.cmd [repo dir], defaults to the current dir. Closing the window does not affect the task.
rem ASCII only: cmd reads this file in the console code page (e.g. 936). The PowerShell script is latestWatchScript in lib/watch.mjs, passed as -EncodedCommand.
set ROOT=%~1
if "%ROOT%"=="" set ROOT=%CD%
cd /d "%ROOT%"
powershell -NoProfile -NoExit -EncodedCommand 
