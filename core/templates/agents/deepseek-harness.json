{
  "name": "deepseek-harness",
  "adapter": "generic",
  "label": "DeepSeek Harness",
  "enabled": true,
  "auth": "token",
  "secrets": { "DEEPSEEK_API_KEY": "DEEPSEEK_API_KEY" },
  "model": null,
  "effort": null,
  "generic": {
    "label": "DeepSeek Harness",
    "executable": "dsh",
    "detect": ["--version"],
    "args": ["headless", "--json", "-"],
    "readOnlyEnv": { "DSH_PERMISSION_MODE": "read-only" },
    "stdin": "{prompt}",
    "output": { "format": "jsonl", "map": [
      { "when": { "type": "final" }, "kind": "say", "text": "text" },
      { "when": { "type": "tool_call", "tool": "pwsh" }, "kind": "cmd", "id": "callId", "command": "input.command" },
      { "when": { "type": "tool_call", "tool": "bash" }, "kind": "cmd", "id": "callId", "command": "input.command" },
      { "when": { "type": "status", "phase": "step_end" }, "kind": "turn", "input": "usage.inputTokens", "outputTokens": "usage.outputTokens" }
    ] },
    "report": "lastSay",
    "failureHints": [
      { "match": "unauthorized|authentication|\\b401\\b|DEEPSEEK_API_KEY", "text": "DeepSeek Harness 没拿到 DeepSeek 的 API Key：设为用户环境变量 DEEPSEEK_API_KEY" },
      { "match": "找不到 DeepSeek Harness 的程序|ENOENT|dsh.*(not found|不是内部或外部命令)|command not found", "text": "没有找到 dsh：用 npm 安装 @deepseek-ai/dsh（需要 Node.js），装好后重新检测" },
      { "match": "\\b429\\b|rate[ _-]?limit|too many requests|quota|insufficient[ _-]?balance|余额不足", "text": "DeepSeek 的接口被限流或余额不足：等一会儿再试，或到 DeepSeek 平台充值，或换别的执行者", "kind": "limit" }
    ]
  },
  "supportsEffort": false,
  "types": ["docs", "test", "research"],
  "title": "DeepSeek Harness",
  "description": "DeepSeek 官方的开源 Agent（开发者预览），用 DeepSeek 的 API Key；没有 Claude、Codex 订阅时可以用它。需要自己用 npm 安装 @deepseek-ai/dsh",
  "recommended": false,
  "order": 8.5
}
