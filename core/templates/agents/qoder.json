{
  "name": "qoder",
  "adapter": "generic",
  "label": "Qoder（国际版）",
  "enabled": true,
  "auth": "token",
  "secrets": { "QODER_PERSONAL_ACCESS_TOKEN": "QODER_PERSONAL_ACCESS_TOKEN" },
  "model": null,
  "effort": null,
  "generic": {
    "label": "Qoder（国际版）",
    "executable": "qodercli",
    "detect": ["--version"],
    "args": ["-p", "--output-format", "stream-json", "--permission-mode", "bypass_permissions", "--no-session-persistence", "-m", "{model}", "--reasoning-effort", "{effort}"],
    "readOnlyArgs": ["-p", "--output-format", "stream-json", "--permission-mode", "dont_ask", "--tools", "Read", "Grep", "Glob", "--no-session-persistence", "-m", "{model}", "--reasoning-effort", "{effort}"],
    "stdin": "{prompt}",
    "output": { "format": "stream-json" },
    "failureHints": [
      { "match": "not logged in|authentication_failed|token .*rejected", "text": "Qoder 国际版没有登录或令牌无效：在 qoder.com 的账户集成页生成个人访问令牌，设为用户环境变量 QODER_PERSONAL_ACCESS_TOKEN" },
      { "match": "\\b429\\b|rate[ _-]?limit|too many requests|quota|insufficient[ _-]?balance|余额不足", "text": "Qoder 国际版额度用完或被限流：等额度恢复，或换别的执行者", "kind": "limit" }
    ]
  },
  "modelOptions": ["Auto", "Fast", "Qwen3.8-Max", "Qwen3.8-Flash", "DeepSeek-V4-Pro", "DeepSeek-Flash", "GLM-5.3", "GLM-5.3-Flash", "Kimi-K3.1-Pro", "Kimi-K2.8-Preview", "MiniMax-M3.1-Flash"],
  "listModels": ["--list-models"],
  "effortOptions": ["auto", "none", "low", "medium", "high", "xhigh", "max", "ultracode"],
  "types": ["research", "docs", "review"],
  "title": "Qoder（国际版）",
  "description": "用 qoder.com 的个人访问令牌；适合调研、阅读类任务，也能写代码",
  "recommended": false,
  "card": { "id": "qoder", "title": "Qoder", "description": "国内版或国际版，用个人访问令牌；适合调研、阅读类任务，也能写代码" },
  "variant": { "label": "版本", "option": "国际版", "help": "程序 qodercli，在 qoder.com 的账户集成页生成个人访问令牌" },
  "order": 8
}
